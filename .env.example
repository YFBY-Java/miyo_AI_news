# Optional paths. Existing local tools are used by default; no automatic model download.
# MOYO_MLX_PYTHON=/absolute/path/to/mlx-environment/bin/python
# MOYO_KIANA_MODEL=/absolute/path/to/Qwen3-TTS-model
# Bundled reference resources default to ./voice-library/琪亚娜-稳重轻角色感.
# MOYO_KIANA_VOICE_DIR=./voice-library/琪亚娜-稳重轻角色感
# MOYO_KIANA_REFERENCE=/absolute/path/to/reference.wav
# MOYO_KIANA_REFERENCE_TEXT=/absolute/path/to/ref_text.txt
# MOYO_KIANA_PRESETS=/absolute/path/to/variants.json
# MOYO_DATA_DIR=/absolute/path/to/local-project-data
