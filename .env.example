# Copy to .env.local when overrides are needed. Shell > .env.local > .env.
# Relative paths resolve from this project directory on Windows and macOS.
# Tools: project .venv first, then PATH; macOS also checks common Homebrew paths.
# MOYO_PYTHON=.venv/Scripts/python.exe
# macOS: MOYO_PYTHON=.venv/bin/python
# MOYO_FFMPEG=tools/ffmpeg.exe
# MOYO_FFPROBE=tools/ffprobe.exe
# MOYO_EDGE_TTS=.venv/Scripts/edge-tts.exe
# MOYO_CHROMIUM=tools/chromium/chrome.exe
# MOYO_DATA_DIR=data
# New Kiana inference requires Apple Silicon macOS and a local MLX environment/model.
# Leave the following overrides unset to reuse the bundled original voice on either OS.
# No model is downloaded automatically.
# MOYO_MLX_PYTHON=.venv-mlx/bin/python
# MOYO_KIANA_MODEL=models/Qwen3-TTS-12Hz-1.7B-Base-4bit
# MOYO_KIANA_VOICE_DIR=./voice-library/琪亚娜-稳重轻角色感
# MOYO_KIANA_REFERENCE=voice-library/琪亚娜-稳重轻角色感/kiana_refs_concat_v2_light.wav
# MOYO_KIANA_REFERENCE_TEXT=voice-library/琪亚娜-稳重轻角色感/reference_audio_v2_light/ref_text.txt
# MOYO_KIANA_PRESETS=voice-library/琪亚娜-稳重轻角色感/test/qwen17b-v2-light-versions/variants.json
